            "Forward": {
              "input_type": "Axis",
              "input_id": -4
            },
            "Right": {
              "input_type": "Axis",
              "input_id": 3
            },
            "Control": {
              "input_type": "Button",
              "input_id": -6
            },
            "Arm": {
              "input_type": "Button",
              "input_id": 1
            },
            "Disarm": {
              "input_type": "Button",
              "input_id": 2
            },
            "Takeoff": {
              "input_type": "Button",
              "input_id": 12
            },
            "Land": {
              "input_type": "Button",
              "input_id": 13
            }
          }
        }
      }
    },
    "external": {
      "server_port": 31659,
      "max_frequency": 100,
      "min_frequency": 1,
      "max_duration": 60
    },
    "optitrack": {
      "server_ip": "127.0.0.1",
      "local_ip": "127.0.0.1",
      "world_axes": ["z", "-x", "-y"],
      "body_axes": ["z", "-x", "-y"],
      "log_frames": false
    }
