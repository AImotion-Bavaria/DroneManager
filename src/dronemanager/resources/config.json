            [2, "Left stick down"],
            [3, "Right stick right"],
            [4, "Right stick down"],
            [5, "Left trigger"],
            [6, "Right trigger"]
          ],
          "button_labels": [
            [1, "Cross"],
            [2, "Circle"],
            [3, "Square"],
            [4, "Triangle"],
            [5, "Share button"],
            [6, "Playstation button"],
            [7, "Options button"],
            [8, "Left stick press"],
            [9, "Right stick press"],
            [10, "Left bumper"],
            [11, "Right bumper"],
            [12, "D-Pad Up"],
            [13, "D-Pad Down"],
            [14, "D-Pad Left"],
            [15, "D-Pad Right"],
            [16, "Touch pad press"]
          ],
          "hold_duration": 2,
          "actions": {
            "Thrust": {
              "input_type": "Axis",
              "input_id": 2
            },
            "Yaw": {
              "input_type": "Axis",
              "input_id": 1
