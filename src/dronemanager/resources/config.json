      "max_h_vel": 2.0,
      "max_down_vel": 0.5,
      "max_up_vel": 1.0,
      "max_h_acc": 1.5,
      "max_v_acc": 0.5,
      "max_h_jerk": 0.5,
      "max_v_jerk": 0.5,
      "max_yaw_vel": 60,
      "max_yaw_acc": 30,
      "max_yaw_jerk": 30,
      "log_telemetry": true,
      "rtsp": null,
      "size": 1.0
