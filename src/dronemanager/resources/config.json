{
  "mav_system_id": 246,
  "mav_component_id": 190,
  "default_plugins": [
    "mission",
    "controllers",
    "external"
  ],
  "default_comm_protocols": [
    "mav"
  ],
  "plugin_settings": {
    "controllers": {
      "auto_assign": true,
      "default_mappings": {
        "PS4 Controller": "PS4 Controller"
